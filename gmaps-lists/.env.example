# Mot de passe d'accès à l'app (obligatoire dès qu'elle est en ligne)
APP_PASSWORD=
# Clé Google Maps Platform (APIs « Places API (New) » et « Geocoding API » activées)
GOOGLE_MAPS_API_KEY=
# Dossier des données (base SQLite, session Google, captures d'échec)
DATA_DIR=./data
# « mock » pour simuler les exports sans compte Google
EXPORT_DRIVER=
PORT=3000

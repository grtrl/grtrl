{
  "name": "gmaps-lists",
  "version": "1.0.0",
  "private": true,
  "description": "Importer ses listes Google Maps, les classer par pays et les renvoyer dans Google Maps.",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "google:login": "node scripts/google-login.js",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "fflate": "0.8.2",
    "playwright": "1.63.0"
  }
}
